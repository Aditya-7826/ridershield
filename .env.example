# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker-compose maps this host port to the container)
POSTGRES_USER=ridershield
POSTGRES_PASSWORD=ridershield
POSTGRES_DB=ridershield
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Ollama (local only)
OLLAMA_HOST=http://localhost:11434
TEXT_MODEL=qwen2.5:3b
VISION_MODEL=qwen2.5vl:3b
# Unload models soon after use to save RAM
OLLAMA_KEEP_ALIVE=2m
# Leave empty to let Ollama choose. Set 0 to force CPU if a small GPU
# fails with "cudaMalloc failed: out of memory".
OLLAMA_NUM_GPU=
# CPU-only inference on a busy laptop can be slow
LLM_TIMEOUT_SECONDS=600

# Random seed for the synthetic data generator
SEED=42
